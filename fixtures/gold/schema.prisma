}

model AppSetting {
  id          Int      @id @default(autoincrement())
  settingKey  String   @unique
  configData  Json
  updatedAt   DateTime @updatedAt
  updatedById Int?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
}

model Webhook {
  id          Int     @id @default(autoincrement())
  targetUrl   String
  secretHash  String
  isActive    Boolean @default(true)
  createdById Int
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
}

model QuarantinedRow {
  id          Int      @id @default(autoincrement())
  sourceModel String
  sourceId    String
  reason      String // orphan_fk | duplicate_loser | dangling_token | unparseable
  payload     Json
  createdAt   DateTime @default(now())

  @@index([sourceModel])
  @@map("quarantined_row")
}

model MigrationIdMap {
  id          Int    @id @default(autoincrement())
  sourceModel String
  sourceId    String
  targetModel String
  targetId    String

  @@unique([sourceModel, sourceId])
  @@map("migration_id_map")
}
