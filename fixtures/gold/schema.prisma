generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  FREELANCE
  INTERNSHIP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
}

enum ActivityKind {
  CALL
  EMAIL
  MEETING
  VISIT
}

enum AttributeKind {
  TEXT
  NUMBER
  FLAG
}

enum MovementKind {
  RECEIPT
  TRANSFER
  ISSUE
  ADJUSTMENT
}

enum StocktakeStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum PaymentMethodKind {
  CARD
  SEPA_DEBIT
  BANK_TRANSFER
  WALLET
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
}

enum TrackingEventKind {
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum ProjectRole {
  LEAD
  CONTRIBUTOR
  REVIEWER
}

enum ConsentPurpose {
  NEWSLETTER
  PROFILING
  THIRD_PARTY
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

model User {
  id                      Int                      @id @default(autoincrement())
  emailAddress            String                   @unique
  displayName             String
  isActive                Boolean                  @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  apiKeys                 ApiKey[]
  appSettings             AppSetting[]
  auditEvents             AuditEvent[]
  documentShares          DocumentShare[]
  documentVersions        DocumentVersion[]
  documents               Document[]
  emailTemplates          EmailTemplate[]
  employee                Employee?
  folders                 Folder[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  segments                Segment[]
  sessions                Session[]
  ticketLabels            TicketLabel[]
  userCredential          UserCredential?
  userRoles               UserRole[]
  webhooks                Webhook[]
}

model Role {
  id              Int              @id @default(autoincrement())
  roleKey         String           @unique
  title           String
  details         String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  permissionKey   String           @unique
  details         String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     Int
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPrefix String    @unique
  label     String
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserCredential {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash      String
  mfaSecret         String?
  passwordChangedAt DateTime
}

model Department {
  id                  Int          @id @default(autoincrement())
  departmentCode      String       @unique
  title               String
  parentId            Int?
  parent              Department?  @relation("DepartmentParent", fields: [parentId], references: [id], onDelete: Restrict)
  costCenter          String?
  departmentsAsParent Department[] @relation("DepartmentParent")
  employees           Employee[]
  positions           Position[]
  teams               Team[]

  @@index([parentId])
}

model Position {
  id           Int        @id @default(autoincrement())
  positionCode String     @unique
  title        String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  minSalary    Decimal?   @db.Decimal(12, 2)
  maxSalary    Decimal?   @db.Decimal(12, 2)
  employees    Employee[]

  @@index([departmentId])
}

model Employee {
  id                           Int                  @id @default(autoincrement())
  employeeNumber               String               @unique
  firstName                    String
  lastName                     String
  workEmail                    String               @unique
  departmentId                 Int
  department                   Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId                   Int
  position                     Position             @relation(fields: [positionId], references: [id], onDelete: Restrict)
  managerId                    Int?
  manager                      Employee?            @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  userId                       Int?                 @unique
  user                         User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  hiredOn                      DateTime             @db.Date
  terminatedOn                 DateTime?            @db.Date
  dateOfBirth                  DateTime?            @db.Date
  emergencyContactName         String?
  emergencyContactPhone        String?
  absencesAsApprovedBy         Absence[]            @relation("AbsenceApprovedBy")
  absencesAsEmployee           Absence[]            @relation("AbsenceEmployee")
  activities                   Activity[]
  campaigns                    Campaign[]
  crmNotes                     CrmNote[]
  customers                    Customer[]
  employeeSkills               EmployeeSkill[]
  employeesAsManager           Employee[]           @relation("EmployeeManager")
  employmentContracts          EmploymentContract[]
  leads                        Lead[]
  opportunities                Opportunity[]
  performanceReviewsAsEmployee PerformanceReview[]  @relation("PerformanceReviewEmployee")
  performanceReviewsAsReviewer PerformanceReview[]  @relation("PerformanceReviewReviewer")
  projectMembers               ProjectMember[]
  taskComments                 TaskComment[]
  tasks                        Task[]
  teamMemberships              TeamMembership[]
  teams                        Team[]
  ticketMessages               TicketMessage[]
  tickets                      Ticket[]
  timeEntries                  TimeEntry[]

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
}

model EmploymentContract {
  id           Int          @id @default(autoincrement())
  employeeId   Int
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType ContractType
  startsOn     DateTime     @db.Date
  endsOn       DateTime?    @db.Date
  weeklyHours  Decimal?     @db.Decimal(4, 1)
  annualSalary Decimal      @db.Decimal(12, 2)
  signedAt     DateTime

  @@index([employeeId])
}

model AbsenceType {
  id       Int       @id @default(autoincrement())
  typeCode String    @unique
  title    String
  isPaid   Boolean
  absences Absence[]
}

model Absence {
  id            Int         @id @default(autoincrement())
  employeeId    Int
  employee      Employee    @relation("AbsenceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  absenceTypeId Int
  absenceType   AbsenceType @relation(fields: [absenceTypeId], references: [id], onDelete: Restrict)
  startsOn      DateTime    @db.Date
  endsOn        DateTime    @db.Date
  approvedById  Int?
  approvedBy    Employee?   @relation("AbsenceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  note          String?

  @@index([employeeId])
  @@index([absenceTypeId])
  @@index([approvedById])
}

model Team {
  id              Int              @id @default(autoincrement())
  title           String
  departmentId    Int
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  leadId          Int?
  lead            Employee?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  teamMemberships TeamMembership[]

  @@index([departmentId])
  @@index([leadId])
}

model TeamMembership {
  teamId     Int
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  joinedOn   DateTime @db.Date

  @@id([teamId, employeeId])
  @@index([employeeId])
}

model Skill {
  id             Int             @id @default(autoincrement())
  title          String          @unique
  details        String?
  employeeSkills EmployeeSkill[]
}

model EmployeeSkill {
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId     Int
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency Int

  @@id([employeeId, skillId])
  @@index([skillId])
}

model PerformanceReview {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation("PerformanceReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId Int      @map("reviewer_id")
  reviewer   Employee @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewDate DateTime @map("review_date") @db.Date
  score      Int
  summary    String?

  @@index([employeeId])
  @@index([reviewerId])
  @@map("performance_reviews")
}

model PublicHoliday {
  id          Int      @id @default(autoincrement())
  holidayDate DateTime @unique @db.Date
  title       String
  isHalfDay   Boolean  @default(false)
}

model Industry {
  id           Int        @id @default(autoincrement())
  industryCode String     @unique
  title        String
  customers    Customer[]
}

model Customer {
  id                 Int                 @id @default(autoincrement())
  customerNumber     String              @unique
  companyName        String
  billingEmail       String
  phone              String?
  vatId              String?
  industryId         Int?
  industry           Industry?           @relation(fields: [industryId], references: [id], onDelete: Restrict)
  accountManagerId   Int?
  accountManager     Employee?           @relation(fields: [accountManagerId], references: [id], onDelete: Restrict)
  creditLimit        Decimal?            @db.Decimal(12, 2)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  billingAccounts    BillingAccount[]
  carts              Cart[]
  contacts           Contact[]
  crmNotes           CrmNote[]
  customerAddresses  CustomerAddress[]
  opportunities      Opportunity[]
  projects           Project[]
  salesOrders        SalesOrder[]
  segmentMemberships SegmentMembership[]
  tickets            Ticket[]

  @@index([industryId])
  @@index([accountManagerId])
}

model Contact {
  id                      Int                      @id @default(autoincrement())
  customerId              Int
  customer                Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName               String
  lastName                String
  emailAddress            String?
  jobTitle                String?
  isPrimary               Boolean
  activities              Activity[]
  contactPhones           ContactPhone[]
  marketingConsents       MarketingConsent[]
  newsletterSubscriptions NewsletterSubscription[]

  @@index([customerId])
}

model ContactPhone {
  id          Int     @id @default(autoincrement())
  contactId   Int
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  slot        Int
  phoneNumber String

  @@unique([contactId, slot])
}

model CustomerAddress {
  id                Int          @id @default(autoincrement())
  customerId        Int
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label             String?
  street            String
  postalCode        String
  city              String
  countryCode       String
  isDefaultShipping Boolean
  salesOrders       SalesOrder[]
  shipments         Shipment[]

  @@index([customerId])
}

model LeadSource {
  id        Int    @id @default(autoincrement())
  sourceKey String @unique
  title     String
  leads     Lead[]
}

model Lead {
  id           Int        @id @default(autoincrement())
  fullName     String
  companyName  String?
  emailAddress String?
  leadSourceId Int
  leadSource   LeadSource @relation(fields: [leadSourceId], references: [id], onDelete: Restrict)
  status       LeadStatus
  ownerId      Int?
  owner        Employee?  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@index([leadSourceId])
  @@index([ownerId])
}

model PipelineStage {
  id             Int           @id @default(autoincrement())
  title          String
  sortOrder      Int           @unique
  winProbability Int
  opportunities  Opportunity[]
}

model Opportunity {
  id              Int           @id @default(autoincrement())
  customerId      Int
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  title           String
  stageId         Int
  stage           PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  expectedValue   Decimal       @db.Decimal(12, 2)
  expectedCloseOn DateTime?     @db.Date
  ownerId         Int?
  owner           Employee?     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  competitorId    Int?
  competitor      Competitor?   @relation(fields: [competitorId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  activities      Activity[]

  @@index([customerId])
  @@index([stageId])
  @@index([ownerId])
  @@index([competitorId])
}

model Activity {
  id            Int          @id @default(autoincrement())
  activityKind  ActivityKind
  subject       String
  contactId     Int?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  opportunityId Int?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  employeeId    Int
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  occurredAt    DateTime

  @@index([contactId])
  @@index([opportunityId])
  @@index([employeeId])
}

model CrmNote {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   Int
  author     Employee @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([authorId])
}

model Competitor {
  id            Int           @id @default(autoincrement())
  companyName   String
  websiteUrl    String?
  opportunities Opportunity[]
}

model Brand {
  id         Int       @id @default(autoincrement())
  brandName  String    @unique
  websiteUrl String?
  products   Product[]
}

model Category {
  id                 Int               @id @default(autoincrement())
  categorySlug       String            @unique
  title              String
  parentId           Int?
  parent             Category?         @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  categoriesAsParent Category[]        @relation("CategoryParent")
  productCategories  ProductCategory[]

  @@index([parentId])
}

model Product {
  id                     Int                     @id @default(autoincrement())
  productNumber          String                  @unique
  title                  String
  details                String?
  brandId                Int?
  brand                  Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  isActive               Boolean                 @default(true)
  weightGrams            Int?
  lengthMm               Int?
  widthMm                Int?
  heightMm               Int?
  createdAt              DateTime                @default(now())
  productAttributeValues ProductAttributeValue[]
  productCategories      ProductCategory[]
  productImages          ProductImage[]
  productTags            ProductTag[]
  productVariants        ProductVariant[]

  @@index([brandId])
}

model UnitOfMeasure {
  id              Int              @id @default(autoincrement())
  uomCode         String           @unique
  title           String
  productVariants ProductVariant[]
}

model ProductVariant {
  id                 Int                 @id @default(autoincrement())
  productId          Int
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String              @unique
  variantLabel       String
  price              Decimal             @db.Decimal(12, 2)
  uomId              Int?
  uom                UnitOfMeasure?      @relation(fields: [uomId], references: [id], onDelete: Restrict)
  isActive           Boolean             @default(true)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  priceListEntries   PriceListEntry[]
  purchaseOrderLines PurchaseOrderLine[]
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  stocktakeLines     StocktakeLine[]

  @@index([productId])
  @@index([uomId])
}

model ProductCategory {
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model AttributeDefinition {
  id                     Int                     @id @default(autoincrement())
  attributeKey           String                  @unique
  title                  String
  valueKind              AttributeKind
  productAttributeValues ProductAttributeValue[]
}

model ProductAttributeValue {
  id          Int                 @id @default(autoincrement())
  productId   Int
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueText   String

  @@unique([productId, attributeId])
  @@index([attributeId])
}

model Tag {
  id          Int          @id @default(autoincrement())
  tagText     String       @unique
  productTags ProductTag[]
}

model ProductTag {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model PriceList {
  id               Int              @id @default(autoincrement())
  title            String
  currencyId       Int
  currency         Currency         @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  validFrom        DateTime         @db.Date
  validUntil       DateTime?        @db.Date
  priceListEntries PriceListEntry[]

  @@index([currencyId])
}

model PriceListEntry {
  id               Int            @id @default(autoincrement())
  priceListId      Int
  priceList        PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  unitPrice        Decimal        @db.Decimal(12, 2)

  @@unique([priceListId, productVariantId])
  @@index([productVariantId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int
  imageUrl  String

  @@unique([productId, sortOrder])
}

model Warehouse {
  id               Int               @id @default(autoincrement())
  warehouseCode    String            @unique
  title            String
  street           String
  city             String
  postalCode       String
  purchaseOrders   PurchaseOrder[]
  stocktakes       Stocktake[]
  storageLocations StorageLocation[]
}

model StorageLocation {
  id                           Int             @id @default(autoincrement())
  warehouseId                  Int
  warehouse                    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationCode                 String
  stockLevels                  StockLevel[]
  stockMovementsAsFromLocation StockMovement[] @relation("StockMovementFromLocation")
  stockMovementsAsToLocation   StockMovement[] @relation("StockMovementToLocation")

  @@unique([warehouseId, locationCode])
}

model StockLevel {
  id                Int             @id @default(autoincrement())
  productVariantId  Int
  productVariant    ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  storageLocationId Int
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  quantityOnHand    Int
  quantityReserved  Int

  @@unique([productVariantId, storageLocationId])
  @@index([storageLocationId])
}

model StockMovement {
  id               Int              @id @default(autoincrement())
  productVariantId Int
  productVariant   ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  fromLocationId   Int?
  fromLocation     StorageLocation? @relation("StockMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId     Int?
  toLocation       StorageLocation? @relation("StockMovementToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  movementKind     MovementKind
  quantity         Int
  movedAt          DateTime

  @@index([productVariantId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model Stocktake {
  id             Int             @id @default(autoincrement())
  warehouseId    Int
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  countedOn      DateTime        @db.Date
  status         StocktakeStatus
  stocktakeLines StocktakeLine[]

  @@index([warehouseId])
}

model StocktakeLine {
  id               Int            @id @default(autoincrement())
  stocktakeId      Int
  stocktake        Stocktake      @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  expectedQuantity Int
  countedQuantity  Int

  @@index([stocktakeId])
  @@index([productVariantId])
}

model Supplier {
  id             Int             @id @default(autoincrement())
  supplierCode   String          @unique
  companyName    String
  contactEmail   String
  phone          String?
  paymentTermId  Int?
  paymentTerm    PaymentTerm?    @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  websiteUrl     String?
  ratingScore    Int?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]

  @@index([paymentTermId])
}

model PurchaseOrder {
  id                  Int                 @id @default(autoincrement())
  purchaseOrderNumber String              @unique
  supplierId          Int
  supplier            Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId         Int
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status              PurchaseOrderStatus
  orderedAt           DateTime
  expectedOn          DateTime?           @db.Date
  purchaseOrderLines  PurchaseOrderLine[]

  @@index([supplierId])
  @@index([warehouseId])
}

model PurchaseOrderLine {
  id               Int            @id @default(autoincrement())
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  orderedQuantity  String
  unitCost         Decimal        @db.Decimal(12, 2)

  @@index([purchaseOrderId])
  @@index([productVariantId])
}

model SalesChannel {
  id          Int          @id @default(autoincrement())
  channelKey  String       @unique
  title       String
  carts       Cart[]
  salesOrders SalesOrder[]
}

model Cart {
  id             Int          @id @default(autoincrement())
  customerId     Int?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesChannelId Int
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cartItems      CartItem[]

  @@index([customerId])
  @@index([salesChannelId])
}

model CartItem {
  id               Int            @id @default(autoincrement())
  cartId           Int
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  quantity         Int
  addedAt          DateTime

  @@index([cartId])
  @@index([productVariantId])
}

model SalesOrder {
  id                  Int                  @id @default(autoincrement())
  orderReference      String               @unique
  customerId          Int
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesChannelId      Int
  salesChannel        SalesChannel         @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)
  status              OrderStatus
  placedAt            DateTime
  currencyId          Int
  currency            Currency             @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  shippingAddressId   Int?
  shippingAddress     CustomerAddress?     @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  discountRedemptions DiscountRedemption[]
  invoices            Invoice[]
  orderItems          OrderItem[]
  orderStatusChanges  OrderStatusChange[]
  returnRequests      ReturnRequest[]
  shipments           Shipment[]

  @@index([customerId])
  @@index([salesChannelId])
  @@index([currencyId])
  @@index([shippingAddressId])
}

