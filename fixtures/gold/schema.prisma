  billingName        String
  /// @snapshot: billing address when the invoice was issued
  billingStreet      String
  /// @snapshot: billing address when the invoice was issued
  billingPostalCode  String
  /// @snapshot: billing address when the invoice was issued
  billingCity        String
  /// @snapshot: invoice totals as issued; legally fixed
  totalNet           Decimal             @db.Decimal(12, 2)
  /// @snapshot: invoice totals as issued; legally fixed
  totalTax           Decimal             @db.Decimal(12, 2)
  /// @snapshot: invoice totals as issued; legally fixed
  totalGross         Decimal             @db.Decimal(12, 2)
  creditNotes        CreditNote[]
  dunningNotices     DunningNotice[]
  invoiceLines       InvoiceLine[]
  paymentAllocations PaymentAllocation[]

  @@index([billingAccountId])
  @@index([salesOrderId])
  @@index([currencyId])
}

