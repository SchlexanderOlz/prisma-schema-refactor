  id                 Int                 @id @default(autoincrement())
  invoiceNumber      String              @unique
  billingAccountId   Int
  billingAccount     BillingAccount      @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  salesOrderId       Int?
  salesOrder         SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  currencyId         Int
  currency           Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  status             InvoiceStatus
  issuedOn           DateTime            @db.Date
  dueOn              DateTime            @db.Date
